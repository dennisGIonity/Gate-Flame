<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Reach the node over the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tell "no node on this network" apart from "node is down", so the app
         can say which one instead of showing a generic error. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The node advertises itself over mDNS as gateflame.local so the app can
         find it on any subnet without the customer typing an IP. mDNS is
         multicast; without this the lock is held only for unicast and
         discovery silently fails on some OEM Wi-Fi stacks. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Deliberately NOT requested:
         ACCESS_FINE_LOCATION      — not needed; we do not scan for SSIDs.
         READ_PHONE_STATE          — not needed; pairing does not use IMEI.
         REQUEST_INSTALL_PACKAGES  — the kiosk download page hands off to the
                                     browser, the app never side-loads.
         Every permission added here has to be justified to a customer buying a
         security product. Keep the list this short. -->
</manifest>
