{
  "name": "gateflame-desktop",
  "productName": "Gate^Flame",
  "version": "1.0.2",
  "description": "Gate^Flame desktop console — Ionity Global network security & privacy node. Pairs with a Gate^Flame box on your LAN.",
  "author": "Dennis Grobler (Wabakipi) <dennis.g@ionity.today>",
  "homepage": "https://www.ionity.today",
  "license": "LicenseRef-AED-900",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:web": "cd .. && npm run build:html-mobile",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win portable nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "today.ionity.gateflame.desktop",
    "productName": "Gate^Flame",
    "copyright": "(c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd - All Rights Reserved - TM2",
    "artifactName": "GateFlame-Desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../release/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      { "from": "../dist-mobile", "to": "web", "filter": ["**/*"] }
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "GateFlame-Desktop-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "category": "Network;Security",
      "icon": "build/icon.png",
      "maintainer": "Dennis Grobler <dennis.g@ionity.today>",
      "synopsis": "Gate^Flame desktop console"
    },
    "publish": null
  }
}
