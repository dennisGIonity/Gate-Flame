{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:standalone": "vite build -c vite.standalone.config.ts",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); fs.rmSync('release', {recursive:true, force:true});\"",
    "lint": "tsc --noEmit",
    "build:all": "npm run build:html-mobile && npm run build:html-kiosk && npm run build:apks",
    "build:html-mobile": "tsx scripts/build-html.ts mobile",
    "build:html-kiosk": "tsx scripts/build-html.ts kiosk",
    "build:apk-mobile": "tsx scripts/build-apk.ts mobile",
    "build:apk-kiosk": "tsx scripts/build-apk.ts kiosk",
    "package:release": "npm run build:html-mobile && npm run build:html-kiosk && tar -czvf release/GateFlame-Complete-Package.tar.gz dist-mobile dist-kiosk",
    "build:apks": "npm run build:apk-mobile && npm run build:apk-kiosk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mqtt": "^5.15.2",
    "ping": "^1.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "speedtest-net": "^2.2.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
