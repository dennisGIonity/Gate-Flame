# Gate^Flame Fleet — Caddy front door for docker-compose.yml.
# FLEET_DOMAIN comes from fleet.env (e.g. feeds.ionity.today). Point its DNS
# A/AAAA record at this server BEFORE first start so the certificate issues.
{
	email {$FLEET_ACME_EMAIL}
}

{$FLEET_DOMAIN} {
	encode zstd gzip
	# Caddy sets X-Forwarded-For / -Proto / -Host itself (ignoring client-sent
	# values). The app also trusts X-Forwarded-Prefix from this proxy, so this
	# proxy must own that header too: drop whatever a client sent. HSTS and the
	# Secure cookie come from the app, which sees X-Forwarded-Proto: https.
	reverse_proxy fleet:8091 {
		header_up -X-Forwarded-Prefix
	}
	# The dashboard is at the root of the domain. To serve it under a path
	# instead, replace the reverse_proxy block above with:
	#   redir /gateflame /gateflame/ 308
	#   handle_path /gateflame/* {
	#     reverse_proxy fleet:8091 {
	#       header_up X-Forwarded-Prefix /gateflame
	#     }
	#   }
}
