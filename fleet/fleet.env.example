# Gate^Flame Fleet — server environment (docker compose `env_file`, systemd
# `EnvironmentFile`). Copy to fleet.env, fill in, chmod 600. Never commit it.
# On the Windows offline server the same values live in fleet.env.ps1.

# Nodes use this ONCE, to enrol; each then receives its own token. Must equal
# GATEFLAME_FEED_TOKEN on the boxes. Keep the SAME value when you migrate, or
# boxes that have not yet activated their own token cannot enrol.
GATEFLAME_FLEET_TOKEN=<long random string>

GATEFLAME_FLEET_ADMIN_USER=admin
GATEFLAME_FLEET_ADMIN_PASSWORD=<pick a strong password>

# Optional. Without it a random signing key is created and kept in fleet.db,
# so sessions survive restarts and a move with the database.
# GATEFLAME_FLEET_SESSION_SECRET=<long random string>
# GATEFLAME_FLEET_SESSION_HOURS=12
# GATEFLAME_FLEET_COOKIE_SECURE=auto        # auto | always | never
# GATEFLAME_FLEET_LOGIN_MAX_FAILURES=8
# GATEFLAME_FLEET_LOGIN_WINDOW_SECONDS=900
# GATEFLAME_FLEET_STALE_SECONDS=1800

# docker-compose.yml / Caddy only
FLEET_DOMAIN=feeds.example.com
FLEET_ACME_EMAIL=ops@example.com
