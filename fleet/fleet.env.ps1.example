# Gate^Flame Fleet — local secrets template.
#
# Copy this file to fleet.env.ps1 (same folder) and fill in your own values.
# fleet.env.ps1 is gitignored and must never be committed — see .gitignore.
#
#   cp fleet.env.ps1.example fleet.env.ps1
#
# Then edit the three lines below and run start-fleet.ps1.

$env:GATEFLAME_FLEET_TOKEN = "<pick a long random string — nodes use this ONCE, to enrol>"
$env:GATEFLAME_FLEET_ADMIN_USER = "admin"
$env:GATEFLAME_FLEET_ADMIN_PASSWORD = "<pick a password — this logs you into the dashboard>"
