// COPY TO secrets.h - or let t1/scripts/build-flash.ps1 write it (it prompts for the Wi-Fi
// password locally and reads the device token from the T1 server). secrets.h is git-ignored.
#pragma once
#define WIFI_SSID            "your-ssid"
#define WIFI_PASS            "your-password"
#define T1_DEVICE_TOKEN      "from: python -m t1server device-token"
#define T1_SERVER_FALLBACK   "http://192.168.124.4:8095"   // used only if mDNS _gft1._tcp is not found
#define T1_DEFAULT_LEVEL     "low"

// Optional fixed address. The router's upstream DNS points at this box, so its IP must
// not move: either reserve it in the router's DHCP, or set it here.
// #define T1_STATIC_IP      "192.168.124.20"
// #define T1_GATEWAY        "192.168.124.1"
// #define T1_SUBNET         "255.255.255.0"
